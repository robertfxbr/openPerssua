{
  "name": "openperssua",
  "version": "0.2.8",
  "description": "Open-source desktop AI meeting copilot overlay — pluggable LLM backends (OpenAI API, ChatGPT subscription via OAuth, Claude API, Claude Code CLI, Ollama). Portfolio reimplementation based on public behavior analysis.",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && node build-installer.js",
    "dist:win": "npm run build && node build-installer.js"
  },
  "build": {
    "appId": "com.openperssua.app",
    "productName": "OpenPerssua",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "extraFiles": [
      {
        "from": "whisper-bin",
        "to": "resources/whisper-bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OpenPerssua"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "electron-audio-loopback": "^1.0.6",
    "electron-log": "^5.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "author": {
    "name": "Robert",
    "url": "https://github.com/robertfxbr"
  },
  "homepage": "https://github.com/robertfxbr/openPerssua",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertfxbr/openPerssua.git"
  }
}

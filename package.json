{
  "name": "teka",
  "productName": "Teka",
  "version": "0.4.10",
  "description": "Open-source desktop AI meeting copilot overlay. Works with the LLM you already have, no extra API bill: ChatGPT login, Claude Code CLI, Codex CLI, Gemini CLI, Ollama or a local server (paid APIs optional). Portfolio reimplementation based on public behavior analysis.",
  "license": "MIT",
  "main": "electron/bootstrap.js",
  "teka": {
    "shellMin": "0.4.0",
    "shellDeps": {
      "electron": "38.8.6",
      "better-sqlite3": "12.11.1",
      "electron-audio-loopback": "1.0.6",
      "electron-log": "5.4.4"
    }
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "test:assistants": "node scripts/test-assistants.cjs",
    "test:mcp": "node scripts/test-mcp.cjs",
    "start": "electron .",
    "dist": "npm run build && node build-installer.js",
    "dist:win": "npm run build && node build-installer.js",
    "dist:update": "npm run build && node scripts/build-update.js"
  },
  "build": {
    "appId": "com.teka.app",
    "productName": "Teka",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "extraFiles": [
      {
        "from": "whisper-bin",
        "to": "resources/whisper-bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Teka"
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "electron-audio-loopback": "^1.0.6",
    "electron-log": "^5.4.3"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^25.0.0",
    "lucide-react": "1.72.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "author": {
    "name": "Robert",
    "url": "https://github.com/robertfxbr"
  },
  "homepage": "https://github.com/robertfxbr/openPerssua",
  "contributors": [
    "OpenAI Codex (contribuição assistida por IA)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/robertfxbr/openPerssua.git"
  }
}
